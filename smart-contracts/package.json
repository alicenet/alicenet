{
  "name": "alicenet-contracts",
  "version": "1.0.0",
  "description": "AliceNet 1.0 Smart Contracts",
  "main": "dist/src/index.js",
  "typings": "dist/src/index.d.ts",
  "scripts": {
    "build:ts": "rimraf dist && tsc -p tsconfig.json",
    "clean": "rm -rf dist/ && npx hardhat clean",
    "start": "npx hardhat node",
    "compile": "npx hardhat compile",
    "lint-solidity": "solhint 'contracts/**/*.sol' 'test_sol/**/*.sol'",
    "lint": "eslint 'test/**/*.ts' 'scripts/**/*.ts'",
    "prettier": "prettier --write 'contracts/**/*.sol'",
    "test": "npm exec hardhat test --show-stack-traces",
    "test-parallel": "npm run test -- --parallel",
    "format": "prettier --write 'contracts/**/*.sol' 'test/**/*.ts' 'scripts/**/*.ts'"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.2",
    "@nomicfoundation/hardhat-ethers": "^3.0.4",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.9",
    "@nomicfoundation/hardhat-toolbox": "^3.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.12",
    "@nomiclabs/hardhat-ethers": "^2.2.3",
    "@openzeppelin/contracts-upgradeable": "^4.9.6",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.9",
    "@types/chai-as-promised": "^7.1.7",
    "@types/mocha": "^10.0.3",
    "@typescript-eslint/eslint-plugin": "^6.9.0",
    "@typescript-eslint/parser": "^6.9.0",
    "axios": "^1.11.0",
    "cdk-validium-contracts": "github:alicenet/zkevm-contracts.git",
    "chai": "^4.3.10",
    "chai-as-promised": "^7.1.1",
    "csv-parser": "^3.0.0",
    "dotenv": "^16.3.1",
    "eslint": "^8.52.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-import-resolver-node": "^0.3.9",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-n": "^16.2.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.0.1",
    "eslint-plugin-promise": "^6.1.1",
    "ethers": "^6.9.0",
    "hardhat": "^2.21.0",
    "hardhat-contract-sizer": "^2.10.0",
    "mocha": "^10.2.0",
    "prettier": "^3.0.3",
    "prettier-plugin-organize-imports": "^3.2.3",
    "prettier-plugin-solidity": "^1.1.3",
    "rimraf": "^5.0.5",
    "solhint": "^3.3.7",
    "solhint-plugin-prettier": "^0.0.5",
    "ts-node": "^10.9.1",
    "typechain": "^8.3.2",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "@openzeppelin/contracts": "4.9.6",
    "@openzeppelin/contracts5": "npm:@openzeppelin/contracts@5.0.2",
    "@safe-global/safe-contracts": "1.4.1"
  }
}