{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "incremental": true,
    "declaration": true,
    "declarationMap": true,
    "composite": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "strictPropertyInitialization": false,
    "outDir": "dist"
  },
  "include": [
    "./smart-contracts/index.ts",
    "./scripts/**/*",
    "./types",
    "./test/**/*",
    "./typechain-types/",
    "./benchmark/**/*"
  ],
  "exclude": ["dist"],
  "files": ["./hardhat.config.ts"]
}
